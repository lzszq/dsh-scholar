{
  "name": "@dsh-scholar/research-plugin",
  "version": "0.1.0",
  "description": "DSH Research OS — a fully automated scientific research plugin for DSH (DeepSeek Harness): survey, idea, experiment contract, durable runner jobs, claim-evidence ledger, manuscript and release bundle.",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "license": "BSD-3-Clause",
  "private": true,
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "README.md"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './workers/*' run build && pnpm run build:plugin",
    "build:plugin": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown --config tsdown.client.config.ts",
    "sync:dsh-baseline": "node scripts/sync-dsh-baseline.mjs",
    "check:dsh-baseline": "node scripts/sync-dsh-baseline.mjs --check",
    "verify:docs": "node scripts/verify-docs.mjs",
    "test": "vitest run && pnpm --filter @dsh-scholar/research-ui typecheck",
    "test:watch": "vitest",
    "test:ui:ocr": "node tests/browser/ocr-settings-layout.mjs --width 1280 && node tests/browser/ocr-settings-layout.mjs --width 680",
    "test:fault": "bash tests/fault-injection/run-fault-tests.sh",
    "test:security": "bash tests/security/run-hardening-tests.sh && bash tests/security/run-all-v2-blocking-tests.sh",
    "test:dsh-private": "bash tests/integration/run-dsh-private-registry-tests.sh",
    "test:ci": "bash scripts/ci-gate.sh",
    "test:all": "pnpm run verify:docs && pnpm test && pnpm run test:security && bash tests/e2e/golden-path.sh && bash evals/docker-eval.sh && bash evals/golden-path-v2/run-golden-v2.sh && bash evals/clean-room-rerun.sh",
    "test:all:requires-docker": "echo 'test:all composes unit + security + e2e + evals; the e2e and eval steps require a working docker runtime (docker info must pass; GitHub ubuntu-latest runners provide it)'",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "kernel": "node packages/research-kernel/lib/bin/kernel.js",
    "runner": "node workers/runner-gateway/lib/bin/runner.js",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@dsh-scholar/research-client": "workspace:^",
    "@dsh-scholar/research-kernel": "workspace:^",
    "@dsh-scholar/research-orchestrator": "workspace:^",
    "@dsh-scholar/research-schemas": "workspace:^",
    "@dsh-scholar/scholar-connectors": "workspace:^",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <4.0.1 || >=4.0.1-rc.1 <5",
    "@deepseek-ai/schemastery": ">=3.18.0 <3.18.1 || >=3.18.1-rc.1 <4",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/react": "~18.3.1",
    "@types/node": "^24.0.0",
    "tsdown": "0.22.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "2.9.0",
    "@dsh-scholar/runner-gateway": "workspace:^",
    "react": "^18.2.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  }
}
