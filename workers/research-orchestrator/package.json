{
  "name": "@dsh-scholar/research-orchestrator",
  "version": "0.1.0",
  "description": "DSH Scholar fixture-only automation runtime: durably approves Kernel-authorized Gate allowlists, records typed parks, and reconciles exact receipts across restarts.",
  "type": "module",
  "license": "BSD-3-Clause",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "orchestrator": "lib/bin/orchestrator.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./bin/orchestrator.js": "./lib/bin/orchestrator.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "orchestrator": "node lib/bin/orchestrator.js"
  },
  "dependencies": {
    "@dsh-scholar/research-kernel": "workspace:^",
    "@dsh-scholar/research-schemas": "workspace:^",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
